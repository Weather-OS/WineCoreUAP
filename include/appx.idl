/**
 * SUMMARY:
 *  On Microsoft Windows®, AppX Deployment is done internally via exported
 * functions within AppxDeploymentClient.dll.
 *
 *  Clients can also manage AppX deployment via AppxDeploymentServer.dll, which
 * exposes service COM objects, WinRT classes and exported functions.
 *
 *  Since neither of the aforementioned libraries have publicly available APIs,
 * we cannot replicate exact AppX registeration behavior that Windows does. However,
 * that gives us the freedom to perform our own operations to replicate such behavior.
 *
 *  We will follow the same naming structure and overall flow of the exported library
 * functions, and replicate them within WinRT registries. UNDER NO CIRCUMSTANCES should
 * these functions be called within their corresponding library functions. These are Wine 
 * exclusive.
 *
 * P.S: We purely depend on AppxManifest.xml being present (loose). TODO: probably figure
 * out the overall structure of .AppxPackage files (Xodus could be a valuable resource).
 */

/**
 * In IWineAppXDeploymentClient, we cover:
 *  1) GetApplicability: Whether an IWineAppXPackage is applicable to be installed
 *  2) VerifyPackage: Verifies IWineAppXPackage integrity. (We are mostly guessing how it works. Would return success upon failure.)
 *  3) AppxStagePackage: Stages the current IWineAppXPackage for installation. Gives an IWineStagedAppXPackage.
 *  4) AppxDestagePackage: Destages an IWineStagedAppXPackage.
 *  5) AppxPreRegisterPackage: Package Pre-Registeration stage. Gives an IWineRegisteratableAppXPackage.
 *  6) AppxRegisterPackage: Registers an IWineRegisteratableAppXPackage. (Data is stored in the registry)
 *  7) IsPackageInstalled: Checks whether a specific IWineAppXPackage is installed or not.
 *  8) AppxGetPackageInstalledLocation: Gets the installed location of an IWineAppXPackage.
 *  9) AppxRemovePackageForAllUsers: Removes a registered IWineAppXPackage.
 */


#ifdef __WIDL__
#pragma winrt ns_prefix
#endif

import "inspectable.idl";
import "asyncinfo.idl";
import "eventtoken.idl";
import "windowscontracts.idl";
import "winecontracts.idl";
import "windows.foundation.idl";

namespace WineCoreUAP.AppX
{
    interface IWineAppXPackage;
    interface IWineAppXPackageStatics;
    interface IWineStagedAppXPackage;
    interface IWineRegisteratableAppXPackage;
    interface IWineAppXDeploymentClient;

    runtimeclass WineAppXDeploymentClient;
    runtimeclass WineAppXPackage;

    [
        contract(Windows.Foundation.UniversalApiContract, 1.0),
        uuid(61196092-C2BE-450B-8DD9-6166C12675A6)
    ]
    interface IWineAppXDeploymentClient : IInspectable
    {
    }

    [
        contract(WineCoreUAP.WineCoreUAPContract, 1.0),
        marshaling_behavior(agile),
        static(WineCoreUAP.AppX.IWineAppXDeploymentClient, WineCoreUAP.WineCoreUAPContract, 1.0),
    ]
    runtimeclass WineAppXDeploymentClient
    {
    }
}
